{
  "expo": {
    "name": "FireOps",
    "slug": "fireops",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/fireops-icon.png",
    "scheme": "fireops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/fireops-ios-icon.png",
      "bundleIdentifier": "com.tinykings.fireops",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tinykings.fireops",
      "icon": "./assets/images/fireops-icon.png",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e2231a"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19201D",
          "image": "./assets/images/fireops-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FireOps to select photos for your company fleet and qualification records.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87cec740-d031-4aa2-9c0a-cf8151395d9e"
      }
    },
    "owner": "ryan.inslee"
  }
}
