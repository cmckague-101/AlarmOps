{
  "expo": {
    "name": "AlarmOps",
    "slug": "alarmops",
    "version": "1.0.13",
    "orientation": "default",
    "icon": "./assets/images/alarmops-icon.png",
    "scheme": "alarmops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/alarmops-ios-icon.png",
      "bundleIdentifier": "com.tinykings.fireops",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow AlarmOps to listen while you talk to the assistant.",
        "NSSpeechRecognitionUsageDescription": "Allow AlarmOps to transcribe your questions for the assistant."
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.tinykings.fireops",
      "icon": "./assets/images/alarmops-icon.png",
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e2231a"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19201D",
          "image": "./assets/images/header.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AlarmOps to use your location to find nearby FedRooms hotels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AlarmOps to select photos for your company fleet and qualification records.",
          "cameraPermission": "Allow AlarmOps to photograph licenses and qualification records.",
          "microphonePermission": "Allow AlarmOps to listen while you talk to the assistant."
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AlarmOps to listen while you talk to the assistant.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}
