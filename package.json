{
  "name": "alarmops-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=fireops-web",
    "dev:web": "npm run dev --workspace=fireops-web",
    "dev:mobile": "npm run start --workspace=@fireops/mobile --",
    "ios": "npm run ios --workspace=@fireops/mobile",
    "android": "npm run android --workspace=@fireops/mobile",
    "deploy:mobile:production": "bash apps/mobile/scripts/deploy-production.sh",
    "postinstall": "patch-package",
    "build": "npm run build --workspace=fireops-web",
    "build:web": "npm run build --workspace=fireops-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:db-grants && npm run test:db-audit && npm run test:db-sync && npm run test:db-assistant && npm run test --workspaces --if-present",
    "test:db-grants": "node --test supabase/tests/data-api-grants.test.mjs",
    "test:db-audit": "node --test supabase/tests/company-audit-log.test.mjs",
    "test:db-sync": "node --test supabase/tests/fleet-sync.test.mjs supabase/tests/fleet-sync-conflicts.test.mjs supabase/tests/fleet-sync-review.test.mjs supabase/tests/fleet-sync-device-history.test.mjs supabase/tests/fleet-sync-attachment-uploads.test.mjs supabase/tests/fleet-sync-document-attach.test.mjs supabase/tests/fleet-sync-vehicle-file-slots.test.mjs supabase/tests/fleet-sync-status-assignments.test.mjs supabase/tests/fleet-sync-member-actions.test.mjs supabase/tests/fleet-sync-inspections.test.mjs supabase/tests/fleet-sync-issue-create.test.mjs supabase/tests/user-sync-commands.test.mjs",
    "test:db-assistant": "node --test supabase/tests/assistant-chat.test.mjs supabase/tests/assistant-voice.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "patch-package": "^8.0.1"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
