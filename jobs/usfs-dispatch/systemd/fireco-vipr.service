[Unit]
Description=Fireco VIPR daily discovery and weekly refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ryan
WorkingDirectory=/home/ryan/fireco
EnvironmentFile=/etc/fireco/vipr.env
ExecStart=/bin/bash /home/ryan/fireco/jobs/usfs-dispatch/viprRun.sh
Restart=always
RestartSec=60
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fireco-vipr

[Install]
WantedBy=multi-user.target
