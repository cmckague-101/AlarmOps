# systemd EnvironmentFile syntax, not a shell script. Do not use export or $HOME.
# Keep real credentials only in /etc/fireco/vipr.env (root-owned, mode 600).
# Choose one write path:
# - Direct Postgres (legacy):
SUPABASE_DB_URL='postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require'
# - HTTPS RPC (outbound HTTPS only): comment SUPABASE_DB_URL above and set both below instead
#SUPABASE_URL='https://YOUR-PROJECT.supabase.co'
#SUPABASE_SERVICE_ROLE_KEY='YOUR-SERVICE-ROLE-KEY'
FS_USER_AGENT='FireOps/1.0 (you@example.com)'
FS_REQUEST_INTERVAL=3
VENV=/home/ryan/.local/share/fireops/usfs-venv
